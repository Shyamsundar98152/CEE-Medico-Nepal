rules_version = '2';

// =====================================================================
// CEE MEDICO NEPAL — Question Paper System — Firestore Security Rules
// =====================================================================
// Collections used (all NEW, does not touch existing mcq_sets data):
//
//   question_papers/{paperId}   -> public metadata + page image URLs
//   answer_keys/{paperId}       -> PRIVATE correct-answer map (admin only)
//   exam_attempts/{attemptId}   -> one doc per student attempt
//   admins/{uid}                -> { isAdmin: true }  (bootstrap manually)
//
// The golden rule: a student's browser can NEVER read answer_keys/*.
// Scoring happens exclusively inside Cloud Functions using the Admin
// SDK, which bypasses these rules entirely.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ---------------------------------------------------------------
    // admins/{uid} — bootstrap via Firebase Console or Admin SDK only.
    // No client can ever write here.
    // ---------------------------------------------------------------
    match /admins/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    // ---------------------------------------------------------------
    // question_papers/{paperId} — public once published.
    // ---------------------------------------------------------------
    match /question_papers/{paperId} {
      allow read: if isAdmin() ||
        (resource != null && resource.data.published == true);
      allow create, update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // answer_keys/{paperId} — admin write-only. Students can NEVER
    // read this collection under any circumstance. Cloud Functions
    // read it via the Admin SDK, which ignores these rules.
    // ---------------------------------------------------------------
    match /answer_keys/{paperId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------
    // exam_attempts/{attemptId} — only Cloud Functions (Admin SDK)
    // may create/update these documents, so results can never be
    // forged or self-graded from the client. Students may only read
    // their own attempt; admins may read all.
    // ---------------------------------------------------------------
    match /exam_attempts/{attemptId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if false; // Cloud Functions only
    }
  }
}
